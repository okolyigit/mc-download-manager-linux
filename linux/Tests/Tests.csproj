<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs upstream's self-check (Tests/Program.cs) against the Linux build of the engine. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\Tests\Program.cs" Link="Upstream\Program.cs" />
    <ProjectReference Include="..\MCDM.Core\MCDM.Core.csproj" />
  </ItemGroup>
</Project>

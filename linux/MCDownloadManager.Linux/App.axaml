<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mi="using:Material.Icons.Avalonia"
             x:Class="MCDM.App"
             Name="MC Download Manager"
             RequestedThemeVariant="Default">
  <!-- Own brushes: the WinUI names upstream's WPF code uses (TextFillColorSecondaryBrush…) don't exist in Avalonia's theme. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6B6B6B" />
          <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardStrokeBrush" Color="#1F000000" />
          <SolidColorBrush x:Key="DividerBrush" Color="#14000000" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#F3F3F3" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A3A3A3" />
          <SolidColorBrush x:Key="CardBrush" Color="#1C1C1C" />
          <SolidColorBrush x:Key="CardStrokeBrush" Color="#26FFFFFF" />
          <SolidColorBrush x:Key="DividerBrush" Color="#1AFFFFFF" />
          <SolidColorBrush x:Key="SidebarBrush" Color="#121212" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    <mi:MaterialIconStyles />

    <Style Selector="TextBlock.secondary">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="IndianRed" />
    </Style>
    <Style Selector="mi|MaterialIcon.secondary">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>
    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="Margin" Value="0,0,2,0" />
    </Style>
    <Style Selector="Button.icon mi|MaterialIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
  </Application.Styles>
</Application>
